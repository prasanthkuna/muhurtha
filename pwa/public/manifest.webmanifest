    { "src": "/screenshots/today-card-narrow.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Share a beautiful card of your day" },
    { "src": "/screenshots/welcome-wide.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Muhūrta on a larger screen" }
  ],
  "shortcuts": [
