# =============================================================================
# Muhūrta — root gitignore (secrets, builds, IDE, local-only artifacts)
# =============================================================================

# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.stackdump

# --- IDE / editors / AI tooling ---
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.cursor/
!.cursor/mcp.json
.codex/
.agents/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Secrets & local config (never commit) ---
.env
.env.*
!.env.example
!.env.*.example
**/.env.local
**/secrets.json
**/credentials.json
**/*-credentials.json
**/*.pem
**/*.p12
**/*.pfx
**/service-account*.json
app/dart_defines.json

# --- Archives & large binaries ---
*.zip
*.7z
*.tar
*.tar.gz
*.rar
*.apk
*.aab
*.ipa
*.dmg
*.exe
*.msi
*.jar

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
.cache/
*.hprof

# --- Supabase local / CLI ---
supabase/.temp/
supabase/.branches/
supabase/.env

# --- Vendored tooling (install locally; never commit binaries) ---
tools/

# --- Flutter / Dart (app/) ---
app/.dart_tool/
app/.packages
app/.pub-cache/
app/.pub/
app/build/
app/coverage/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/**/doc/api/
app/**/*.freezed.dart
app/**/*.g.dart
app/.fvm/
app/.fvmrc

# Flutter iOS / macOS generated
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Flutter/ephemeral/
app/ios/Runner/GoogleService-Info.plist
app/ios/Runner/GeneratedPluginRegistrant.*
app/macos/Flutter/ephemeral/
app/macos/Pods/

# Flutter Android generated / local
app/android/.gradle/
app/android/local.properties
app/android/captures/
app/android/.cxx/
app/android/app/build/
app/android/**/GeneratedPluginRegistrant.java
app/android/key.properties
app/android/**/*.keystore
app/android/**/*.jks
app/android/app/src/main/res/values/google-services.json

# Flutter desktop / web ephemeral
app/windows/flutter/ephemeral/
app/linux/flutter/ephemeral/
app/web/.dart_tool/

# --- Deno / Edge Functions (local only) ---
**/.deno/

# Dev-only edge smoke tests (local model experiments)
supabase/functions/muhurtha-api/openrouter_model_smoke.ts

# --- Docs: local phone dumps (use curated assets if needed for docs) ---
docs/screenshots/

# --- Local dev scripts (read API keys from supabase/.env) ---
scripts/compare-nemotron-models.ps1
scripts/test-openrouter-*.ps1

# --- Node (if added later for tooling) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
